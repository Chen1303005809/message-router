[Unit]
Description=Kefu database and event history migration
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/kefu/current /var/lib/kefu

[Service]
Type=oneshot
User=kefu
Group=kefu
WorkingDirectory=/opt/kefu/current
EnvironmentFile=/etc/kefu/web.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/kefu/current/src
ExecStart=/opt/kefu/venv/bin/alembic upgrade head
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/kefu /var/lib/kefu
UMask=0077
