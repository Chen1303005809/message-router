# Local Docker Compose defaults. Never commit real enterprise-WeCom secrets.
POSTGRES_DB=kefu
POSTGRES_USER=kefu
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=kefu-minio
MINIO_ROOT_PASSWORD=change-me-please
S3_BUCKET=kefu-media
WECOM_TRANSPORT=fake

# First-run H5 organization setup. Set INITIAL_ADMIN_WECOM_USERID to
# auto-create/promote the identity on web startup, or set
# ADMIN_BOOTSTRAP_TOKEN and use /setup once from the H5 browser.
# INITIAL_ADMIN_WECOM_USERID=
# INITIAL_ADMIN_DISPLAY_NAME=事件中心总管理员
# ADMIN_BOOTSTRAP_TOKEN=

# Production-only: configure these outside source control.
# AUTH_MODE=wecom_oauth
# WEB_BASE_URL=https://events.example.com
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_CORP_SECRET=
#
# Intelligent-bot long connection (not the self-built-app secret above).
# Set WECOM_TRANSPORT=long_connection after the routing directory is loaded.
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_BOT_MENTION_NAME=客户问题机器人
# WECOM_REQUIRE_GROUP_MENTION=true
# WECOM_LONG_CONNECTION_URL=wss://openws.work.weixin.qq.com
# WECOM_CONNECT_TIMEOUT_SECONDS=20
